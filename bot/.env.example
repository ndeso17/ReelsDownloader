TELEGRAM_BOT_TOKEN=
DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILE_SIZE_MB=50
RATE_LIMIT_SECONDS=10
LOG_LEVEL=INFO

# Bot access mode (FR-013):
#   public : semua user boleh download; whitelist tidak aktif
#   private: hanya user ID terdaftar (OWNER_USER_ID + AUTHORIZED_USER_IDS) yang bisa download
BOT_MODE=public

# Private-mode seeds (hanya dipakai saat BOT_MODE=private):
# OWNER_USER_ID wajib diisi bila BOT_MODE=private (lihat /getID untuk ID kamu)
OWNER_USER_ID=
# Daftar ID tambahan, dipisah koma, contoh: 11111111,22222222 (kosong = tidak ada seed)
AUTHORIZED_USER_IDS=
USERS_FILE=users.json

# User counter & notifikasi admin (FR-021)
# Chat target notifikasi user baru; kosong = fallback OWNER_USER_ID
ADMIN_NOTIFY_CHAT_ID=
# Persistensi hitungan user unik + counter
STATS_FILE=stats.json

# Antrean anti-OOM (FR-022)
# Kapasitas antrean (>=1); penuh -> tolak cepat
QUEUE_MAX_SIZE=20
# Job menunggu lebih dari ini dibatalkan
MAX_QUEUE_WAIT_SECONDS=60
